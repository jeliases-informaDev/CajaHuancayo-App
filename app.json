{
  "expo": {
    "name": "GeoMatrix",
    "slug": "caja-huancayo-auditoria",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F7FD",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F4F7FD",
      "translucent": false,
      "hidden": false
    },
    "scheme": "chauditoria",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.informaperu.chauditoria"
    },
    "android": {
      "package": "pe.informaperu.chauditoria",
      "versionCode": 4,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Esta app usa tu ubicación para registrar y verificar las visitas de auditoría en campo.",
          "locationAlwaysAndWhenInUsePermission": "Durante tu jornada de campo, la app comparte tu ubicación con tu supervisor aunque la pantalla esté apagada o uses el mapa para navegar. Solo ocurre entre «Iniciar jornada» y «Terminar jornada».",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Esta app usa la cámara para registrar evidencia de la visita de auditoría.",
          "photosPermission": "Esta app accede a imágenes únicamente para adjuntar evidencia de la visita."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Esta app usa la cámara para registrar las evidencias obligatorias de cada visita."
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "owner": "jeliasesinformaperu",
    "extra": {
      "eas": {
        "projectId": "d414d0d7-b8ee-445e-bec8-64e23c6f278e"
      }
    }
  }
}
